# --- Cloud LLM provider keys ---
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-..."
GEMINI_API_KEY="..."

# --- LiteLLM admin (master) key: UI login + key management (both instances) ---
LITELLM_MASTER_KEY="sk-admin-master-key"

# --- PostgreSQL ---
POSTGRES_PASSWORD="litellm_pass"

# --- Local cluster mode (unauthenticated) ---
# Bind the local proxy to the cluster interface only. Set to the cluster NIC IP
# (e.g. 192.168.1.50). Also add a host firewall rule so only the cluster subnet
# can reach port 4000. Do not leave 0.0.0.0 in production.
LOCAL_BIND_IP="0.0.0.0"

# --- External mode (Cloudflare Tunnel + Access / Google OIDC) ---
# Token for the named tunnel (Zero Trust -> Networks -> Tunnels -> your tunnel).
CLOUDFLARE_TUNNEL_TOKEN="..."
# Public hostname created in Zero Trust (service -> http://litellm-external:4000).
CLOUDFLARE_TUNNEL_HOSTNAME="llm.example.com"
